# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# --- API ---
STOCK_API_BASE_URL=https://massive.com/api/v1
STOCK_API_KEY=your-api-key-here
STOCK_API_SYMBOLS=AAPL,MSFT,GOOGL

# --- GCP ---
GCP_PROJECT_ID=your-gcp-project-id
GCS_RAW_BUCKET=your-project-stock-ticks-raw
GOOGLE_APPLICATION_CREDENTIALS=/opt/airflow/keys/gcp-key.json

# --- BigQuery ---
BQ_RAW_DATASET=raw
BQ_ANALYTICS_DATASET=analytics
